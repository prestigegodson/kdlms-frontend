# API base URL used by src/api/client.ts. In dev, Vite's proxy (vite.config.ts)
# forwards /api and /actuator to the backend, so this can stay empty (relative
# requests). Set an absolute URL only when the frontend is served separately
# from the backend (e.g. static hosting in production).
VITE_API_BASE_URL=

# Dev-only fallback for utils/host.ts's resolveSchoolSubdomain (Phase 13's
# branded school login pages). Normally the subdomain is read straight off
# the browser hostname (e.g. greenwood.localhost) - set this instead if you'd
# rather keep using plain localhost while testing a school's branding.
VITE_DEV_SUBDOMAIN=
